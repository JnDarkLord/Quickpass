# Quickpass web portal: copy this file to .env (in web/frontend/) and fill in your values.
# Vite builds both values into the portal, so use the Supabase project's public (anon) key,
# never the Service Role Key. On a static host, set them in its environment variables instead.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
