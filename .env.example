# Quickpass: copy this file to .env and fill in the values your station uses.
# Relative paths resolve from the repository root. Blank optional values stay off,
# so a fresh copy starts straight into the first-run setup wizard.

# The Arduino's serial port. Leave blank to run without an Arduino connected.
# Examples: COM3 (Windows), /dev/cu.usbmodem11101 (macOS), /dev/ttyACM0 (Linux)
SERIAL_PORT=
SERIAL_BAUDRATE=9600

# Local SQLite database (used for offline gate decisions on this station).
DATABASE_PATH=quickpass.db

# Optional PostgreSQL connection string for reading historical searches and reports from Supabase.
# Example: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# Optional Supabase project for Cloud Sync. Leave both blank to run offline on this station only.
# The Service Role Key bypasses Row-Level Security: keep it on stations only.
# The web portal's public anon key goes in web/frontend/.env instead.
# Example: https://xxxx.supabase.co
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The School's own policies (School Language, Grades, Sections, school calendar,
# Late Threshold, cooldown, Admin Secret Key) live in School Settings, not here.

# Demo Mode: alternates Check-in and Check-out, accepts typed UIDs, and sends no SMS.
DEMO_MODE=false

# Optional SMS / WhatsApp through Twilio. Messages go out only when TWILIO_ENABLED=true
# and every Twilio value below is filled in.
TWILIO_ENABLED=false
TWILIO_USE_WHATSAPP=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ADMIN_ALERT_PHONE=

# Password required to wipe every Badge or the attendance history. Leave blank to refuse wipes.
WIPE_PASSWORD=

# Folder where the Excel reports are saved.
REPORTS_DIR=Reports
